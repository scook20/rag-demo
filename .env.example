# Copy to .env.local and fill in. .env.local is gitignored and read automatically.
# Never commit real values.

# Gemini Developer API key (used now). Leave unset when using Vertex AI.
GEMINI_API_KEY=

# Postgres + pgvector (matches docker-compose.yml)
DATABASE_URL=postgresql://ragdemo:ragdemo@localhost:5433/ragdemo

# Models (verified 2026-10-21, see docs/decisions.md)
EMBEDDING_MODEL=gemini-embedding-001
GENERATION_MODEL=gemini-3.8-flash

# Later, for Vertex AI on Google Cloud (the google-genai SDK reads these itself)
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=global

# Optional tuning (defaults shown)
# EMBEDDING_DIM=768
# GENERATION_THINKING_LEVEL=low
# MIN_SIMILARITY=0.5
# TOP_K=5
# RAGDEMO_FAKE=1   # use the offline fake embedder and generator
